{
  "name": "MDVIEW — Markdown Viewer",
  "short_name": "MDVIEW",
  "description": "Drop a .md file and read it. No install, no account, no upload.",
  "lang": "ko",
  "dir": "ltr",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#0b0b16",
  "theme_color": "#0b0b16",
  "categories": ["productivity", "utilities"],
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "screenshots": [
    {
      "src": "/shot-wide.png",
      "sizes": "1280x800",
      "type": "image/png",
      "form_factor": "wide",
      "label": "렌더된 마크다운 문서와 목차"
    },
    {
      "src": "/shot-narrow.png",
      "sizes": "720x1280",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "마크다운 파일을 끌어다 놓는 화면"
    }
  ],
  "related_applications": [
    { "platform": "webapp", "url": "https://mdrop.app/manifest.webmanifest" }
  ],
  "prefer_related_applications": false,
  "file_handlers": [
    {
      "action": "/",
      "name": "Markdown",
      "accept": {
        "text/markdown": [".md", ".markdown", ".mdown", ".mkd", ".mdwn"]
      },
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" }],
      "launch_type": "single-client"
    }
  ],
  "launch_handler": { "client_mode": "focus-existing" }
}
